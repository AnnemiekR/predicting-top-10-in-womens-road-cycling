def time_prediction(model: lgb.Booster,
                    X_test: pd.DataFrame,
                    df_test_template: pd.DataFrame,
                    pred_col: str,
                    model_name: str):
    """
    Run model.predict on X_test, time it, attach predictions to a copy of df_test_template,
    and print total + per-race + per-rider prediction time.
    """
    t_pred_start = time.perf_counter()
    df_out = df_test_template.copy()
