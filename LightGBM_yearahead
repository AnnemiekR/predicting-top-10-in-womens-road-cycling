# %% NDCG helpers using same label_gain as LightGBM

def _dcg_at_k(gains: np.ndarray, k: int) -> float:
    k = min(k, len(gains))
    if k == 0:
        return 0.0
    discounts = 1.0 / np.log2(np.arange(2, k + 2))
    return float(np.sum(gains[:k] * discounts))

def ndcg_at_k_labels_scores(
    labels: np.ndarray,
    scores: np.ndarray,
    k: int,
    label_gain: np.ndarray,
) -> float:
    if len(labels) == 0:
        return 0.0

    labels = labels.astype(int)
    gains = label_gain[labels]

    # Ideal DCG
    order_ideal = np.argsort(gains)[::-1]
    ideal_gains = gains[order_ideal]
    idcg = _dcg_at_k(ideal_gains, k)
    if idcg == 0:
        return 0.0

    # Predicted DCG
    order_pred = np.argsort(scores)[::-1]
    pred_gains = gains[order_pred]
    dcg = _dcg_at_k(pred_gains, k)

    return float(dcg / idcg)  # in [0, 1]

