    print(f"\nPrediction time on 2024 for {model_name}: {pred_time_seconds:.3f} seconds")
    print(f"  ≈ {pred_time_seconds / n_races_2024:.6f} seconds per race")
    print(f"  ≈ {pred_time_seconds / n_riders_2024:.6f} seconds per rider")

    return df_out, pred_time_seconds

# %% Helper: SHAP per feature, aggregated per race

def compute_lgbm_contribs(
    booster: lgb.Booster,
    X: pd.DataFrame,
    df_meta: pd.DataFrame,                  # must include query_col and pred_col, same index alignment as X
    feature_names: list[str],
    query_col: str,
    categorical_cols: list[str] = (),
    pred_col: str = "pred",
    num_iteration: int | None = None,       # pass booster.best_iteration if you want
):
    # Align rows by index (important!)
    X_use = X.loc[df_meta.index, feature_names].copy()

    # Keep categoricals as category dtype (LightGBM can handle them if trained that way)
    for c in categorical_cols:
        if c in X_use.columns:
            X_use[c] = X_use[c].astype("category")

    t0 = time.perf_counter()
    contrib = np.asarray(
        booster.predict(X_use, pred_contrib=True, num_iteration=num_iteration)
    )
    shap_time_seconds = float(time.perf_counter() - t0)

    # Expected shape: (n_rows, n_features + 1) where last column is bias/base value
    if contrib.ndim != 2 or contrib.shape[1] != len(feature_names) + 1:
        raise ValueError(
            f"Unexpected contrib shape {contrib.shape}; expected (n, {len(feature_names)+1})."
        )

    bias = contrib[:, -1]
    shap_vals = contrib[:, :-1]

    df_shap = pd.DataFrame(shap_vals, index=X_use.index, columns=feature_names)
    df_shap[query_col] = df_meta.loc[X_use.index, query_col].values
    df_shap[pred_col]  = df_meta.loc[X_use.index, pred_col].values

    return df_shap, bias, shap_time_seconds, X_use

def summarize_shap_topk_and_all(
    df_shap: pd.DataFrame,
    feature_names: list[str],
    query_col: str,
    pred_col: str,
    k: int = 10,
    prefix_all: str = "shap_all_",
    prefix_top: str = "shap_top10_",
):
    # ---- select top-k rows per query by prediction
    top_idx = (
        df_shap[[query_col, pred_col]]
        .groupby(query_col, sort=False)[pred_col]
        .nlargest(k)
        .index.get_level_values(1)
    )
    df_top = df_shap.loc[top_idx]

    # ---- per-query (race) mean |SHAP|
    race_all = (
        df_shap.set_index(query_col)[feature_names]
        .abs().groupby(level=0).mean()
        .rename(columns={f: f"{prefix_all}{f}" for f in feature_names})
        .reset_index()
    )
    race_top = (
        df_top.set_index(query_col)[feature_names]
        .abs().groupby(level=0).mean()
        .rename(columns={f: f"{prefix_top}{f}" for f in feature_names})
        .reset_index()
    )

    # ---- global (overall) mean |SHAP| across rows
    global_all = (
        df_shap[feature_names].abs().mean()
        .sort_values(ascending=False)
        .rename("mean_abs_shap_all")
        .reset_index()
        .rename(columns={"index": "feature"})
    )
    global_top = (
        df_top[feature_names].abs().mean()
        .sort_values(ascending=False)
        .rename(f"mean_abs_shap_top{k}")
        .reset_index()
        .rename(columns={"index": "feature"})
    )

    return {
        "race_all": race_all,
        "race_topk": race_top,
        "global_all": global_all,
        "global_topk": global_top,
        "topk_index": df_top.index,
    }


# %% Variant - tuned hyperparameter & decay & skewness

def tune_lgbm_rank_optuna_cv(
    df,
    folds,
    ndcg_at=ndcg_at,
    n_trials=n_trials,
    seed=42,
):
    """
    Tune tree hyperparameters + decay hyperparameters jointly.
    Uses decay weights in training & validation.
    IMPORTANT FIX: skew transforms are fit ONCE per fold (not per trial).
    """

    # ----------------------------
    # PRECOMPUTE fold data ONCE
    # ----------------------------
    fold_cache = []
    max_age_cap = 1

    for fold in folds:
        train_years = fold["train_years"]
        val_year = fold["val_year"]
        fold_name = fold.get("name", f"val_{val_year}")

        mask_train = df["year"].isin(train_years)
        mask_val   = df["year"] == val_year

        df_train = df.loc[mask_train].copy()
        df_val   = df.loc[mask_val].copy()

        ref_train = df_train["date"].max()
        ref_val   = df_val["date"].max()

        df_train = add_query_age_days(df_train, ref_train)
        df_val   = add_query_age_days(df_val, ref_val)

        max_age_cap = max(max_age_cap, int(df_train["query_age_days"].max()))

        df_train["rel_grade_0_31"] = df_train["rel_grade_0_31"].astype(int)
        df_val["rel_grade_0_31"]   = df_val["rel_grade_0_31"].astype(int)

        # skew transforms fit once per fold (train only)
        transform_specs, _ = fit_auto_skew_transforms(
            df_train=df_train,
            numeric_features=numeric_features,
            categorical_features=categorical,
            skew_threshold=1.0,
            min_rel_improve=0.20,
        )

        df_train_tr, features_train = apply_auto_skew_transforms(
            df_train, features_base, categorical, transform_specs
        )
        df_val_tr, _ = apply_auto_skew_transforms(
            df_val, features_base, categorical, transform_specs
        )

        present_features = [c for c in features_train if c in df_train_tr.columns]
        X_train = df_train_tr[present_features].copy()
        X_val   = df_val_tr[present_features].copy()

        cat_in_X = [c for c in categorical if c in X_train.columns]
        for c in cat_in_X:
            X_train[c] = X_train[c].astype("category")
            X_val[c]   = X_val[c].astype("category")

        y_train = df_train_tr["rel_grade_0_31"].astype(int).values
        y_val   = df_val_tr["rel_grade_0_31"].astype(int).values

        group_train = df_train_tr.groupby("query_id", sort=False).size().to_list()
        group_val   = df_val_tr.groupby("query_id", sort=False).size().to_list()

        fold_cache.append({
            "name": fold_name,
            "val_year": int(val_year),
            "df_train_tr": df_train_tr,
            "df_val_tr": df_val_tr,
            "X_train": X_train,
            "X_val": X_val,
            "y_train": y_train,
            "y_val": y_val,
            "group_train": group_train,
            "group_val": group_val,
            "cat_in_X": cat_in_X,
        })

    # ----------------------------
    # Optuna objective uses cache
    # ----------------------------
    def objective(trial):
        params = {
            **base_lgbm_params,
            "ndcg_eval_at": ndcg_at,
            "learning_rate": trial.suggest_float("learning_rate", 0.01, 0.30, log=True),
            "num_leaves": trial.suggest_int("num_leaves", 7, 127),
            "min_data_in_leaf": trial.suggest_int("min_data_in_leaf", 5, 200),
            "min_sum_hessian_in_leaf": trial.suggest_float(
                "min_sum_hessian_in_leaf", 1e-3, 10.0, log=True
            ),
            "lambda_l1": trial.suggest_float("lambda_l1", 1e-6, 3.0, log=True),
            "lambda_l2": trial.suggest_float("lambda_l2", 1e-6, 20.0, log=True),
        }

        fold_ndcgs = []
        fold_ndcg_by_name = {}
        fold_best_iter_by_name = {}
        fold_val_year_by_name = {}

        metric_key = f"ndcg@{ndcg_at}"

        for fc in fold_cache:
            # decay weights are trial-dependent -> compute here
            w_train_raw = build_query_weights_for_trial(fc["df_train_tr"], trial, max_age_cap)

            w_train = row_weights_from_query_weights(fc["df_train_tr"], w_train_raw, query_col="query_id")

            lgb_train = lgb.Dataset(
                fc["X_train"],
                label=fc["y_train"],
                group=fc["group_train"],
                weight=w_train,
                categorical_feature=fc["cat_in_X"],
                free_raw_data=False,
            )
            lgb_val = lgb.Dataset(
                fc["X_val"],
                label=fc["y_val"],
                group=fc["group_val"],
                reference=lgb_train,
                categorical_feature=fc["cat_in_X"],
                free_raw_data=False,
            )

            booster = lgb.train(
                params,
                lgb_train,
                valid_sets=[lgb_val],
                valid_names=["val"],
                num_boost_round=num_boost_round,
                callbacks=[lgb.early_stopping(stopping_rounds=early_stopping_rounds, verbose=False)],
            )
        
            best_iter = int(booster.best_iteration or num_boost_round)
            fold_ndcg = float(booster.best_score["val"][metric_key])
        
            fold_ndcgs.append(fold_ndcg)
        
            fold_name = fc["name"]
            fold_ndcg_by_name[fold_name] = fold_ndcg
            fold_best_iter_by_name[fold_name] = best_iter
            fold_val_year_by_name[fold_name] = int(fc.get("val_year", -1))

        mean_ndcg_cv = float(np.mean(fold_ndcgs)) if fold_ndcgs else 0.0

        # pick fold with highest ndcg; tie-break by later val_year
        best_fold = max(
            fold_ndcg_by_name.keys(),
            key=lambda fn: (fold_ndcg_by_name[fn], fold_val_year_by_name.get(fn, -1))
        )
        selected_best_iter = int(fold_best_iter_by_name[best_fold])
        
        trial.set_user_attr("fold_ndcg", fold_ndcg_by_name)
        trial.set_user_attr("fold_best_iter", fold_best_iter_by_name)
        trial.set_user_attr("fold_val_year", fold_val_year_by_name)
        trial.set_user_attr("selected_fold", best_fold)
        trial.set_user_attr("selected_best_iter", selected_best_iter)

        return mean_ndcg_cv

    study = optuna.create_study(
        direction="maximize",
        sampler=TPESampler(seed=seed, multivariate=True),
    )
    study.optimize(objective, n_trials=n_trials, show_progress_bar=True)

    fold_ndcg_best = study.best_trial.user_attrs.get("fold_ndcg", {})
    fold_val_year_best = study.best_trial.user_attrs.get("fold_val_year", {})

    best_trial_params = study.best_trial.params
    best_tree_params = {k: v for k, v in best_trial_params.items() if k in tree_keys}
    best_decay_params = {k: v for k, v in best_trial_params.items() if k in decay_keys}

    best_params_full = {
        **base_lgbm_params,
        "ndcg_eval_at": ndcg_at,
        **best_tree_params,
    }

    final_num_boost_round = int(study.best_trial.user_attrs["selected_best_iter"])

    return study, best_params_full, final_num_boost_round, best_decay_params, fold_ndcg_best, fold_val_year_best


