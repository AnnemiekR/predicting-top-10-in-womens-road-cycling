def _json_default(o):
    """
    Robust JSON serializer for numpy/pandas/lightgbm-ish objects.
    Converts to native Python types where possible.
    """
    # numpy scalars
    if isinstance(o, (np.integer,)):
        return int(o)
    if isinstance(o, (np.floating,)):
        return float(o)
    if isinstance(o, (np.bool_,)):
        return bool(o)

    # numpy arrays
    if isinstance(o, np.ndarray):
        return o.tolist()

    # pathlib
    if isinstance(o, Path):
        return str(o)

    # pandas timestamps / datetime-like (best-effort without importing pandas)
    if hasattr(o, "isoformat"):
        try:
            return o.isoformat()
        except Exception:
            pass

    # fallback: stringify (prevents crashes)
    return str(o)


def _sanitize_jsonable(obj):
    """
    Recursively convert dict/list contents so json.dump never sees numpy types.
    (Keeps ints as ints, floats as floats.)
    """
    if isinstance(obj, dict):
        return {str(k): _sanitize_jsonable(v) for k, v in obj.items()}
    if isinstance(obj, (list, tuple)):
        return [_sanitize_jsonable(v) for v in obj]
    # numpy scalars
    if isinstance(obj, (np.integer,)):
        return int(obj)
    if isinstance(obj, (np.floating,)):
        return float(obj)
    if isinstance(obj, (np.bool_,)):
        return bool(obj)
    if isinstance(obj, np.ndarray):
        return obj.tolist()
    # Path
    if isinstance(obj, Path):
        return str(obj)
    # datetime-like
    if hasattr(obj, "isoformat"):
        try:
            return obj.isoformat()
        except Exception:
            return str(obj)
    return obj


def save_one_variant(
    *,
    variant_name: str,
    model,  # lgb.Booster
    out_root: Path,
    final_test_year: int,
    train_years_final=None,      # list[int] | None
    feature_list=None,           # list[str] | None
    transform_specs=None,        # object | None
    extra_meta=None,             # dict | None
):
    out_root = Path(out_root)
    (out_root / "models").mkdir(parents=True, exist_ok=True)
    (out_root / "meta").mkdir(parents=True, exist_ok=True)

    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    train_tag = "unknownTrain"
    if train_years_final:
        # ensure min/max work even if numpy ints are inside
        train_years_py = [int(x) for x in train_years_final]
        train_tag = f"train{min(train_years_py)}-{max(train_years_py)}"

    # 1) Save model
    model_path = out_root / "models" / f"lgbm_{variant_name}_{train_tag}_predict{int(final_test_year)}_{ts}.txt"
    model.save_model(str(model_path))

    # 2) Save feature list
    feat_path = None
    if feature_list is not None:
        feat_path = out_root / "meta" / f"features_{variant_name}_{ts}.json"
        with open(feat_path, "w", encoding="utf-8") as f:
            json.dump(_sanitize_jsonable(feature_list), f, indent=2, default=_json_default)

    # 3) Save transform specs (pickle is fine for arbitrary objects)
    tx_path = None
    if transform_specs is not None:
        tx_path = out_root / "meta" / f"transform_specs_{variant_name}_{ts}.pkl"
        with open(tx_path, "wb") as f:
            pickle.dump(transform_specs, f)

    # 4) Build meta
    meta = {
        "variant": variant_name,
        "saved_at": ts,
        "final_test_year": int(final_test_year),
        "train_years_final": [int(x) for x in train_years_final] if train_years_final else None,
        "n_features": (len(feature_list) if feature_list is not None else None),
        "model_file": str(model_path),
        "features_file": (str(feat_path) if feat_path else None),
        "transform_specs_file": (str(tx_path) if tx_path else None),
    }

    # store model params (may include non-JSON stuff; we'll sanitize)
    try:
        meta["lgbm_params"] = getattr(model, "params", None)
    except Exception:
        meta["lgbm_params"] = None

    if extra_meta:
        meta.update(extra_meta)

    # 5) Save meta JSON (sanitize + robust default)
    meta = _sanitize_jsonable(meta)
    meta_path = out_root / "meta" / f"meta_{variant_name}_{ts}.json"
    with open(meta_path, "w", encoding="utf-8") as f:
        json.dump(meta, f, indent=2, default=_json_default)

    print(f"[saved] {variant_name}")
    print("  model:", model_path)
    if feat_path:
        print("  features:", feat_path)
    if tx_path:
        print("  transforms:", tx_path)
    print("  meta:", meta_path)


# --- where to save everything ---
_final_test_year = globals().get("final_test_year", 2024)
_train_years_final = globals().get("train_years_final", None)

_feature_list_skew = globals().get("present_features_final", None)
