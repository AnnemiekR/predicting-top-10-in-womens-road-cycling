        for c in cat_in_X:
            X_train[c] = X_train[c].astype("category")
            X_val[c]   = X_val[c].astype("category")

        y_train = df_train["rel_grade_0_31"].astype(int).values
        y_val   = df_val["rel_grade_0_31"].astype(int).values

        group_train = df_train.groupby("query_id", sort=False).size().to_list()
