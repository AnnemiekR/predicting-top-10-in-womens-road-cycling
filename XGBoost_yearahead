            k=10,
            prefix_all="shap_all_",
            prefix_top="shap_top10_",
        )

        df_summary = df_summary.merge(summ["race_all"], on=query_col, how="left")
        df_summary = df_summary.merge(summ["race_topk"], on=query_col, how="left")

        all_shap_global_all[variant_name] = summ["global_all"].assign(variant=variant_name)
        all_shap_global_top10[variant_name] = summ["global_topk"].assign(variant=variant_name)

    # add timing cols (optional, but convenient)
    df_summary["train_time_seconds"] = train_time_seconds
    df_summary["pred_time_seconds"] = pred_time_seconds
    df_summary["pred_time_per_race"] = pred_time_seconds / max(1, n_races)
    df_summary["pred_time_per_rider"] = pred_time_seconds / max(1, n_riders)

    all_race_summaries[variant_name] = df_summary

    # ----- hyperparam sheet -----
    rows = []
    for k, v in tree_params_final.items():
        rows.append({"type": "tree", "param": k, "value": v})
    if use_decay:
        for k in ["floor_f", "gamma_strength", "tau_u", "knee_rel_u", "a_dlog"]:
            if tune_decay and (k in decay_params_final):
                rows.append({"type": "decay", "param": k, "value": decay_params_final[k]})
            elif (not tune_decay):
                fixed = {"floor_f": 0.20, "gamma_strength": 0.50, "tau_u": 0.10, "knee_rel_u": 0.50, "a_dlog": 50.0}
                rows.append({"type": "decay", "param": k, "value": fixed[k]})

    rows += [
        {"type": "meta", "param": "num_trees", "value": num_trees_final},
        {"type": "meta", "param": "cv_best_mean_ndcg@10", "value": cv_best},
        {"type": "meta", "param": "train_time_seconds", "value": train_time_seconds},
        {"type": "meta", "param": "pred_time_seconds", "value": pred_time_seconds},
        {"type": "meta", "param": "pred_time_per_race", "value": pred_time_seconds / max(1, n_races)},
        {"type": "meta", "param": "pred_time_per_rider", "value": pred_time_seconds / max(1, n_riders)},
    ]

    # ✅ add per-fold NDCG rows (only when Optuna ran)
    # (this is exactly what you asked: fold NDCG goes into the Excel hyperparameter sheet)
    for fold_name, fold_score in fold_ndcg_best.items():
        rows.append({
            "type": "cv_fold",
            "param": f"{fold_name}_ndcg@{ndcg_at}",
            "value": float(fold_score),
        })

    # add final evaluation metrics
    for mk, mv in metrics.items():
        rows.append({"type": "final_eval", "param": mk, "value": mv})

    all_hyperparams[variant_name] = pd.DataFrame(rows)

    print("Final (2024) metrics:", metrics)

