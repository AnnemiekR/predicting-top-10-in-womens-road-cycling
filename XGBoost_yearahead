import os
import pandas as pd

if not all_race_summaries:
    raise RuntimeError("No variants were run. Set at least one run_variants[...] = True.")

def write_sheets_safely(path: str, sheets: dict[str, pd.DataFrame]):
    """
    Write multiple DataFrames to an Excel workbook.

    - If workbook exists: append mode, replace sheets with the same name.
    - If workbook does not exist: create it.
    """
    file_exists = os.path.exists(path)
    mode = "a" if file_exists else "w"

    if mode == "a":
        # append + replace the sheets we write
        with pd.ExcelWriter(path, engine="openpyxl", mode="a", if_sheet_exists="replace") as writer:
            for sheet_name, df in sheets.items():
                # Excel sheet name limit = 31 chars
                safe_name = str(sheet_name)[:31]
                df.to_excel(writer, sheet_name=safe_name, index=False)
    else:
        # create new workbook
        with pd.ExcelWriter(path, engine="openpyxl", mode="w") as writer:
            for sheet_name, df in sheets.items():
                safe_name = str(sheet_name)[:31]
                df.to_excel(writer, sheet_name=safe_name, index=False)

# 1) Race summaries workbook
race_out = "1_year_before_race_summaries_all_models_2024_rerun.xlsx"
