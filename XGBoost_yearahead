# %% Helper NDCG

def _dcg_at_k(gains: np.ndarray, k: int) -> float:
    k = min(k, len(gains))
    if k == 0:
        return 0.0
    discounts = 1.0 / np.log2(np.arange(2, k + 2))
    return float(np.sum(gains[:k] * discounts))

def ndcg_at_k_labels_scores(labels: np.ndarray, scores: np.ndarray, k: int, label_gain: np.ndarray) -> float:
    if len(labels) == 0:
        return 0.0
    labels = labels.astype(int)
    gains = label_gain[labels]

    order_ideal = np.argsort(gains)[::-1]
    idcg = _dcg_at_k(gains[order_ideal], k)
    if idcg == 0:
        return 0.0

    order_pred = np.argsort(scores)[::-1]
    dcg = _dcg_at_k(gains[order_pred], k)
    return float(dcg / idcg)


def mean_ndcg_over_queries(df_sorted: pd.DataFrame, preds: np.ndarray, k: int, label_gain: np.ndarray) -> float:
    tmp = df_sorted[[query_col, label_col]].copy()
    tmp["pred"] = preds
    vals = []
    for _, g in tmp.groupby(query_col, sort=False):
        labels_q = g[label_col].astype(int).values
        scores_q = g["pred"].astype(float).values
        k_eff = min(k, len(labels_q))
        vals.append(ndcg_at_k_labels_scores(labels_q, scores_q, k=k_eff, label_gain=label_gain))
    return float(np.mean(vals)) if vals else 0.0


# %% Query-age + decay weights

def add_query_age_days(df_sub: pd.DataFrame, ref_date: pd.Timestamp) -> pd.DataFrame:
    q_date = df_sub.groupby(query_col, sort=False)[date_col].max()
    q_age = (ref_date - q_date).dt.days.clip(lower=0)
    out = df_sub.copy()
    out["query_age_days"] = out[query_col].map(q_age).astype(int)
    return out


def w_delayed_logistic_continuous(t, tau, t_knee, a, f):
    t = np.asarray(t, dtype=float)
    s = lambda x: 1.0 / (1.0 + np.exp((x - t_knee) / max(a, 1e-12)))
    w = np.ones_like(t, dtype=float)
    mask = t >= tau
    if np.any(mask):
        s_tau = max(s(tau), 1e-12)
        w[mask] = f + (1.0 - f) * (s(t[mask]) / s_tau)
    return np.clip(w, f, 1.0)


def build_query_weights_for_trial(df_sub: pd.DataFrame, trial, max_age_cap: int) -> np.ndarray:
    if "query_age_days" not in df_sub.columns:
        raise KeyError("df_sub must contain 'query_age_days' before building decay weights.")

    max_age_local = int(max(1, df_sub["query_age_days"].max()))
    max_age_cap = int(max(1, max_age_cap))

    f = trial.suggest_float("floor_f", 0.01, 1.0)
    gamma_strength = trial.suggest_float("gamma_strength", 0.0, 1.0)

    tau_u = trial.suggest_float("tau_u", 0.0, 1.0)
    tau = int(np.floor(tau_u * max_age_local))

    knee_rel_u = trial.suggest_float("knee_rel_u", 0.0, 1.0)
    t_knee = tau + int(np.floor(knee_rel_u * (max_age_local - tau)))

    a_low = 1.0
    a_high = max(a_low, max_age_cap / 4.394)
    a = trial.suggest_float("a_dlog", a_low, a_high, log=True)

    t_days = df_sub["query_age_days"].values.astype(float)
    w_decay = w_delayed_logistic_continuous(t_days, tau, t_knee, a, f)
    w_final = (1.0 - gamma_strength) + gamma_strength * w_decay

    eps = 1e-6
    return np.clip(w_final, 1e-12, 1.0 - eps).astype(float)


# %% Skew transforms

def fit_auto_skew_transforms(
    df_train: pd.DataFrame,
    numeric_features: List[str],
    categorical_features: List[str],
    skew_threshold: float = 1.0,
    min_rel_improve: float = 0.20,
    min_n: int = 10,
) -> Tuple[Dict[str, Dict[str, Any]], pd.DataFrame]:
    """
    Two-stage rule (UPDATED):
      Stage 1: try log1p ONLY for features that are nonnegative in TRAIN
               AND not in the explicit NO-LOG blacklist.
               If log1p achieves |skew| <= threshold, pick it and stop.
      Stage 2: otherwise, consider Yeo–Johnson and pick the best candidate overall.
    """

    # Explicit blacklist: these can be negative / unstable across years
    NO_LOG_FEATURES = {
        "pcs_points_change_vs_prev_year",
        "pcs_points_pct_change_same_profile",
        "relative_team_rank",
        "relative_team_rank_same_profile",
    }

    cat = set(categorical_features)
    transform_specs: Dict[str, Dict[str, Any]] = {}
    report_rows: List[Dict[str, Any]] = []

    def _to_float_arr(s: pd.Series) -> np.ndarray:
        return pd.to_numeric(s, errors="coerce").astype(float).to_numpy()

    def _sk(arr: np.ndarray) -> float:
        x = arr[np.isfinite(arr)]
        if x.size < min_n:
            return np.nan
        if np.nanstd(x) < 1e-12:
            return 0.0
        return float(scipy_skew(x, bias=False))

    def _accept(orig_sk: float, new_sk: float) -> bool:
        if not np.isfinite(new_sk):
            return False
        # accept if it crosses threshold, OR improves enough relative to original
        if abs(new_sk) <= skew_threshold:
            return True
        return abs(new_sk) <= (1.0 - min_rel_improve) * abs(orig_sk)

    for feat in numeric_features:
        if feat not in df_train.columns or feat in cat:
            continue

        xv = _to_float_arr(df_train[feat])
        orig_sk = _sk(xv)

        # If already ok / not computable: keep
        if not np.isfinite(orig_sk) or abs(orig_sk) <= skew_threshold:
            transform_specs[feat] = {"method": "identity"}
            report_rows.append({
                "feature": feat, "status": "kept",
                "orig_skew": float(orig_sk) if np.isfinite(orig_sk) else np.nan,
                "method": "identity",
                "new_skew": float(orig_sk) if np.isfinite(orig_sk) else np.nan,
            })
            continue

        finite_mask = np.isfinite(xv)
        if not finite_mask.any():
            transform_specs[feat] = {"method": "identity"}
            report_rows.append({
                "feature": feat, "status": "skipped",
                "orig_skew": float(orig_sk), "method": "identity", "new_skew": np.nan,
            })
            continue

        min_val = float(np.nanmin(xv[finite_mask]))

        # ----------------------------
        # Stage 1: log1p ONLY (no shift)
        # ----------------------------
        log_evals: List[Tuple[str, Dict[str, Any], float]] = []

        can_try_log = (min_val >= 0.0) and (feat not in NO_LOG_FEATURES)
        if can_try_log:
            x_log = np.full_like(xv, np.nan, dtype=float)
            x_log[finite_mask] = np.log1p(xv[finite_mask])
            sk_log = _sk(x_log)
            if np.isfinite(sk_log):
                log_evals.append(("log1p", {}, float(sk_log)))

        # pick best log (smallest |skew|)
        best_log = None
        if log_evals:
            best_log = min(log_evals, key=lambda t: abs(t[2]))  # (method, params, new_skew)

        # If log reaches the threshold, choose log and do NOT consider YJ
        log_good = [t for t in log_evals if abs(t[2]) <= skew_threshold]
        if log_good:
            method, params, new_sk = min(log_good, key=lambda t: abs(t[2]))
            best = {"method": method, "params": params, "new_skew": float(new_sk)}
        else:
            # ----------------------------
            # Stage 2: consider Yeo–Johnson
            # ----------------------------
            best = None
            yj_eval = None
            try:
                pt = PowerTransformer(method="yeo-johnson", standardize=False)
                z = pt.fit_transform(xv[finite_mask].reshape(-1, 1)).ravel()
                z_full = np.full_like(xv, np.nan, dtype=float)
                z_full[finite_mask] = z
                yj_sk = _sk(z_full)
                if np.isfinite(yj_sk):
                    yj_eval = ("yeojohnson", {"pt": pt}, float(yj_sk))
            except Exception:
                yj_eval = None

            # compare best available log (even if still > threshold) vs YJ
            candidates = []
            if best_log is not None:
                candidates.append(best_log)
            if yj_eval is not None:
                candidates.append(yj_eval)

            if candidates:
                method, params, new_sk = min(candidates, key=lambda t: abs(t[2]))
                best = {"method": method, "params": params, "new_skew": float(new_sk)}

        # Decide accept vs keep original
        if best is None or (not _accept(orig_sk, best["new_skew"])):
            transform_specs[feat] = {"method": "identity"}
            report_rows.append({
                "feature": feat, "status": "kept",
                "orig_skew": float(orig_sk), "method": "identity", "new_skew": float(orig_sk),
            })
        else:
            transform_specs[feat] = {"method": best["method"], **best["params"]}
            report_rows.append({
                "feature": feat, "status": "transformed",
                "orig_skew": float(orig_sk),
                "method": best["method"],
                "new_skew": float(best["new_skew"]),
            })

    report = (
        pd.DataFrame(report_rows)
          .sort_values(["status", "feature"])
          .reset_index(drop=True)
    )
    return transform_specs, report


def apply_auto_skew_transforms(
    df: pd.DataFrame,
    features_base: List[str],
    categorical_features: List[str],
    transform_specs: Dict[str, Dict[str, Any]],
) -> Tuple[pd.DataFrame, List[str]]:

    cat = set(categorical_features)
    df_out = df.copy()
    used_features: List[str] = []

    for feat in features_base:
        if feat not in df_out.columns:
            continue

        if feat in cat:
            used_features.append(feat)
            continue

        spec = transform_specs.get(feat, {"method": "identity"})
        method = spec.get("method", "identity")

        x = pd.to_numeric(df_out[feat], errors="coerce").astype(float)
        arr = x.to_numpy()
        m = np.isfinite(arr)
        arr_new = arr.copy()

        if method == "log1p":
            # Guard log1p domain: requires x > -1
            z = arr[m].copy()
            z[z <= -1.0] = np.nan
            arr_new[m] = np.log1p(z)

        elif method == "yeojohnson":
            pt = spec.get("pt", None)
            if pt is not None and m.any():
                arr_new[m] = pt.transform(arr[m].reshape(-1, 1)).ravel()

        # identity does nothing
        df_out[feat] = pd.Series(arr_new, index=df_out.index)
        used_features.append(feat)

    return df_out, used_features


# %% DMatrix builder for ranking

def _sort_for_groups(df_in: pd.DataFrame) -> pd.DataFrame:
    # stable sort keeps relative order
    return df_in.sort_values([query_col], kind="mergesort")


def make_rank_dmatrix(
    df_in: pd.DataFrame,
    feature_cols: List[str],
    label_name: str,
    row_weights: np.ndarray | None,
):
    df_sorted = _sort_for_groups(df_in)

    X = df_sorted[feature_cols].copy()
    for c in categorical_cols:
        if c in X.columns:
            X[c] = X[c].astype("category")

    y = df_sorted[label_name].astype(float).values
    dmat = xgb.DMatrix(X, label=y, enable_categorical=True)

    group_sizes = df_sorted.groupby(query_col, sort=False).size().tolist()
    dmat.set_group(group_sizes)

    if row_weights is not None:
        w = pd.Series(np.asarray(row_weights, dtype=float), index=df_in.index)
        w_sorted = w.reindex(df_sorted.index).to_numpy()

        if np.isnan(w_sorted).any():
            raise ValueError("Weights reindexing produced NaNs (index mismatch).")
        if not np.isfinite(w_sorted).all():
            raise ValueError("Weights contain inf/-inf.")
        if (w_sorted <= 0).any():
            raise ValueError("Weights must be strictly positive.")

        # convert row weights -> per-group weights (one per query)
        w_group = (
            pd.Series(w_sorted, index=df_sorted.index)
              .groupby(df_sorted[query_col], sort=False)
              .mean()
              .to_numpy()
        )
        w_group = w_group / max(1e-12, float(np.mean(w_group)))  # mean if fine considering that rows within a query all get the same weight - see function add_query_age_days

        if len(w_group) != len(group_sizes):
            raise ValueError("Group weight length mismatch.")
        dmat.set_weight(w_group.astype(float))

    return dmat, df_sorted

# %% SHAP values per race

def compute_xgb_contribs(
    booster: xgb.Booster,
    X: pd.DataFrame,
    df_meta: pd.DataFrame,                 # must include query_col and pred_col, same index as X
    feature_names: list[str],
    query_col: str,
    categorical_cols: list[str] = (),
    pred_col: str = "pred",
):
    # Align rows by index (important!)
    X_use = X.loc[df_meta.index, feature_names].copy()
    for c in categorical_cols:
        if c in X_use.columns:
            X_use[c] = X_use[c].astype("category")

    dmat = xgb.DMatrix(X_use, enable_categorical=True)

    t0 = time.perf_counter()
    contrib = np.asarray(booster.predict(dmat, pred_contribs=True))
    shap_time_seconds = float(time.perf_counter() - t0)

    # Expect bias term as last column
    if contrib.shape[1] != len(feature_names) + 1:
        raise ValueError(f"Unexpected contrib shape {contrib.shape}; expected (n, {len(feature_names)+1}).")

    bias = contrib[:, -1]
    shap_vals = contrib[:, :-1]  # SHAP values per feature

    df_shap = pd.DataFrame(shap_vals, index=X_use.index, columns=feature_names)
    df_shap[query_col] = df_meta.loc[X_use.index, query_col].values
    df_shap[pred_col]  = df_meta.loc[X_use.index, pred_col].values

    return df_shap, bias, shap_time_seconds, X_use


def summarize_shap_topk_and_all(
    df_shap: pd.DataFrame,
    feature_names: list[str],
    query_col: str,
    pred_col: str,
    k: int = 10,
    prefix_all: str = "shap_all_",
    prefix_top: str = "shap_top10_",
):
    # ---- select top-k rows per query by prediction
    top_idx = (
        df_shap[[query_col, pred_col]]
        .groupby(query_col, sort=False)[pred_col]
        .nlargest(k)
        .index.get_level_values(1)
    )
    df_top = df_shap.loc[top_idx]

    # ---- per-query (race) mean |SHAP|
    race_all = (
        df_shap.set_index(query_col)[feature_names]
        .abs().groupby(level=0).mean()
        .rename(columns={f: f"{prefix_all}{f}" for f in feature_names})
        .reset_index()
    )
    race_top = (
        df_top.set_index(query_col)[feature_names]
        .abs().groupby(level=0).mean()
        .rename(columns={f: f"{prefix_top}{f}" for f in feature_names})
        .reset_index()
    )

    # ---- global (overall) mean |SHAP| across rows
    global_all = (
        df_shap[feature_names].abs().mean()
        .sort_values(ascending=False)
        .rename("mean_abs_shap_all")
        .reset_index()
        .rename(columns={"index": "feature"})
    )
    global_top = (
        df_top[feature_names].abs().mean()
        .sort_values(ascending=False)
        .rename(f"mean_abs_shap_top{k}")
        .reset_index()
        .rename(columns={"index": "feature"})
    )

    return {
        "race_all": race_all,
        "race_topk": race_top,
        "global_all": global_all,
        "global_topk": global_top,
        "topk_index": df_top.index,
    }


# %% json.dump default handler: ensures metadata containing numpy scalars/arrays, pandas timestamps, and Paths

def json_default(o):
    # numpy scalars
    if isinstance(o, (np.integer,)):
        return int(o)
    if isinstance(o, (np.floating,)):
        return float(o)
    # numpy arrays
    if isinstance(o, (np.ndarray,)):
        return o.tolist()
    # pandas timestamp / datetime
    if isinstance(o, (pd.Timestamp, datetime)):
        return o.isoformat()
    # paths
    if isinstance(o, Path):
        return str(o)
    raise TypeError(f"Object of type {type(o).__name__} is not JSON serializable")


# %% Save each xgb model

def save_xgb_variant(
    *,
    variant_name: str,
    booster: xgb.Booster,
    out_root: Path,
    final_test_year: int,
    train_years_final: list[int],
    feature_cols: list[str],
    transform_specs: object | None = None,   # for *_skew variants
    params_final: dict | None = None,
    extra_meta: dict | None = None,
    save_dump_txt: bool = True,
):
    out_root.mkdir(parents=True, exist_ok=True)
    (out_root / "models").mkdir(parents=True, exist_ok=True)
    (out_root / "meta").mkdir(parents=True, exist_ok=True)

    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    train_tag = f"train{min(train_years_final)}-{max(train_years_final)}"

    # Reloadable model file
    model_path = out_root / "models" / f"xgb_{variant_name}_{train_tag}_predict{final_test_year}_{ts}.json"
    booster.save_model(str(model_path))

    # Optional: human-readable dump (NOT reloadable)
    dump_path = None
    if save_dump_txt:
        dump_path = out_root / "models" / f"xgb_{variant_name}_{train_tag}_predict{final_test_year}_{ts}.txt"
        booster.dump_model(str(dump_path))

    # Feature list (this file should contain ONLY the feature columns)
    feat_path = out_root / "meta" / f"features_{variant_name}_{ts}.json"
    with open(feat_path, "w", encoding="utf-8") as f:
        json.dump(feature_cols, f, indent=2, default=json_default)

    # Skew transform specs (pickle because it may contain PowerTransformer objects)
    tx_path = None
    if transform_specs is not None:
        tx_path = out_root / "meta" / f"transform_specs_{variant_name}_{ts}.pkl"
        with open(tx_path, "wb") as f:
            pickle.dump(transform_specs, f)

    meta = {
        "variant": variant_name,
        "saved_at": ts,
        "final_test_year": final_test_year,
        "train_years_final": train_years_final,
        "model_file": str(model_path),
        "dump_txt_file": (str(dump_path) if dump_path else None),
        "features_file": str(feat_path),
        "transform_specs_file": (str(tx_path) if tx_path else None),
        "xgb_params": (params_final if params_final is not None else None),
    }
    if extra_meta:
        meta.update(extra_meta)

    meta_path = out_root / "meta" / f"meta_{variant_name}_{ts}.json"
    with open(meta_path, "w", encoding="utf-8") as f:
        json.dump(meta, f, indent=2, default=json_default)

    print(f"[saved] {variant_name}")
    print("  model:", model_path)
    if dump_path: print("  dump :", dump_path)
    print("  feats:", feat_path)
    if tx_path:  print("  tx   :", tx_path)
    print("  meta :", meta_path)

