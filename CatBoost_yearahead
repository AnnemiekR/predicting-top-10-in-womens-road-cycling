    fold_ndcg_by_name = {}
    fold_trees_by_name = {}
    fold_year_map = {f["name"]: int(f["val_year"]) for f in folds}

    for fold in folds:
        df_train, df_val = prepare_train_val_split(df_all, fold["train_years"], fold["val_year"])

        df_train_tr, df_val_tr, present_features, _ = apply_skew_if_needed(df_train, df_val, use_skew)

        X_train = df_train_tr[present_features].copy()
        X_val   = df_val_tr[present_features].copy()

        for c in categorical:
            if c in X_train.columns:
                X_train[c] = X_train[c].astype("category")
            if c in X_val.columns:
                X_val[c] = X_val[c].astype("category")

        y_train = df_train_tr["rel_grade_0_31"].astype(int).values
        y_val   = df_val_tr["rel_grade_0_31"].astype(int).values

        group_train = df_train_tr["query_id"].values
        group_val   = df_val_tr["query_id"].values

        cat_idx_fold = [present_features.index(c) for c in categorical if c in present_features]

        train_pool = Pool(
            data=X_train,
            label=y_train,
            group_id=group_train,
            cat_features=cat_idx_fold,
        )
        val_pool = Pool(
            data=X_val,
            label=y_val,
            group_id=group_val,
            cat_features=cat_idx_fold,
        )

        model = CatBoostRanker(
            thread_count=thread_count,
            loss_function="YetiRank",
            eval_metric=cat_eval_metric,
            boosting_type="Ordered",
            sampling_unit="Group",
            bootstrap_type="Bernoulli",
            depth=depth_default,
            l2_leaf_reg=l2_leaf_reg_default,
            subsample=subsample_default,
            random_seed=seed,
            task_type="CPU",
            iterations=iterations_default,
            od_type="Iter",
            od_wait=early_stopping_rounds,
            verbose=False,
        )

        model.fit(train_pool, eval_set=val_pool, use_best_model=True, verbose=False)

        fold_trees.append(int(model.tree_count_))

        val_pred = model.predict(val_pool)
        df_val_metric = df_val_tr.copy()
        df_val_metric["pred"] = val_pred
        df_val_metric["label"] = y_val

        ndcgs_this_fold = []
        for _, g in df_val_metric.groupby("query_id"):
            labels_q = g["label"].values.astype(int)
            scores_q = g["pred"].values.astype(float)
            k_eff = min(ndcg_at, len(labels_q))
            ndcgs_this_fold.append(
                ndcg_at_k_labels_scores(labels_q, scores_q, k=k_eff, label_gain=label_gain)
            )

        fold_mean_ndcg = float(np.mean(ndcgs_this_fold)) if ndcgs_this_fold else 0.0
        fold_ndcgs.append(float(fold_mean_ndcg) if ndcgs_this_fold else 0.0)

        fold_ndcg_by_name[fold["name"]] = float(fold_mean_ndcg)
        fold_trees_by_name[fold["name"]] = int(model.tree_count_)

    cv_mean_ndcg = float(np.mean(fold_ndcgs)) if fold_ndcgs else 0.0
    if fold_ndcg_by_name:
        best_fold = max(
            fold_ndcg_by_name.keys(),
            key=lambda fn: (fold_ndcg_by_name[fn], fold_year_map.get(fn, -1)),
        )
        mean_trees = int(fold_trees_by_name[best_fold])
    else:
        mean_trees   = int(fold_trees[-1]) if fold_trees else num_boost_round

    return cv_mean_ndcg, mean_trees


# %% Final train/test builders (skew/no-skew)

def build_final_train_test(use_skew: bool):
    train_years_final, df_train_final, df_test_final = final_train_test_split(df, final_test_year)

    if use_skew:
        transform_specs_final, _ = fit_auto_skew_transforms(
            df_train=df_train_final,
            numeric_features=numeric_features,
            categorical_features=categorical,
            skew_threshold=1.0,
            min_rel_improve=0.20,
        )
        df_train_final_tr, FEATURES_FINAL = apply_auto_skew_transforms(
            df_train_final, features_base, categorical, transform_specs_final
        )
        df_test_final_tr, _ = apply_auto_skew_transforms(
            df_test_final, features_base, categorical, transform_specs_final
        )
    else:
        transform_specs_final = None
        df_train_final_tr = df_train_final.copy()
        df_test_final_tr  = df_test_final.copy()
        FEATURES_FINAL = list(features_base)

    present_features_final = [c for c in FEATURES_FINAL if c in df_train_final_tr.columns]
    X_train_final = df_train_final_tr[present_features_final].copy()
    X_test_final  = df_test_final_tr[present_features_final].copy()

    for c in categorical:
        if c in X_train_final.columns:
            X_train_final[c] = X_train_final[c].astype("category")
        if c in X_test_final.columns:
            X_test_final[c] = X_test_final[c].astype("category")

    y_train_final = df_train_final_tr["rel_grade_0_31"].astype(int)
    group_id_train_final = df_train_final_tr["query_id"].values
    group_id_test_final  = df_test_final_tr["query_id"].values

    cat_feature_indices = [present_features_final.index(c) for c in categorical if c in present_features_final]
    
    return (
        train_years_final,
        df_train_final_tr,
        df_test_final_tr,
        X_train_final,
        X_test_final,
        y_train_final,
        group_id_train_final,
        group_id_test_final,
        present_features_final,
        cat_feature_indices,
        transform_specs_final,  
    )



# %% Variant runners (8 variants)

def run_variant(
    variant_sheet: str,
    use_skew: bool,
    tuned_tree: bool,
    use_decay: bool,
):
    """
    Returns (df_summary, df_hparams) for the variant.
    """

    # --- Build final split for this skew setting
    (
    train_years_final,
    df_train_final_tr,
    df_test_final_tr,
    X_train_final,
    X_test_final,
    y_train_final,
    group_id_train_final,
    group_id_test_final,
    present_features_final,
    cat_feature_indices,
    transform_specs_final,   # <-- add
    ) = build_final_train_test(use_skew)

    # --- Choose params
    study = None
    best_tree = None
    best_decay = {}
    num_trees = None
    cv_best = None

    # Tuned tree + decay
    if tuned_tree and use_decay:
        study, best_tree, best_decay, num_trees = tune_catboost_ranker_cv_with_decay(
            df_all=df,
            folds=folds,
            use_skew=use_skew,
            ndcg_at=ndcg_at,
            n_trials=n_trials,
            seed=seed,
        )
        cv_best = float(study.best_value)

    # Default tree + tuned decay
    elif (not tuned_tree) and use_decay:
        study, best_decay, num_trees = tune_catboost_decay_only_cv(
            df_all=df,
            folds=folds,
            use_skew=use_skew,
            ndcg_at=ndcg_at,
            n_trials=n_trials,
            seed=seed,
        )
        cv_best = float(study.best_value)

        # fixed defaults
        best_tree = {
            "depth": 6,
            "l2_leaf_reg": 3.0,
            "subsample": 0.5,
            # NOTE: learning_rate not set (CatBoost chooses default)
        }

    # Tuned tree, no decay
    elif tuned_tree and (not use_decay):
        study, best_tree, num_trees = tune_catboost_ranker_cv_nodecay(
            df_all=df,
            folds=folds,
            use_skew=use_skew,
            ndcg_at=ndcg_at,
            n_trials=n_trials,
            seed=seed,
        )
        cv_best = float(study.best_value)

    # Default tree, no decay
    else:
        cv_best, num_trees = estimate_trees_default_nodecay(
            df_all=df,
            folds=folds,
            use_skew=use_skew,
        )
        best_tree = {
            "depth": 6,
            "l2_leaf_reg": 3.0,
            "subsample": 0.5,
            # NOTE: learning_rate not set (CatBoost chooses default)
        }

    # --- Build weights (decay or no-decay)
    w_train_row = None
    if use_decay:
        if "date" not in df_train_final_tr.columns:
            raise KeyError("Need 'date' for decay weights in final train.")

        # compute query_age_days in final train relative to end of train period
        ref_date = df_train_final_tr["date"].max()
        df_train_final_tr = add_query_age_days(df_train_final_tr, ref_date)

        max_age_cap_final = int(df_train_final_tr["query_age_days"].max())

        class DummyTrial:
            def __init__(self, p): self.p = p
            def suggest_float(self, name, *args, **kwargs): return float(self.p[name])

        dummy = DummyTrial(best_decay)
        w_q_like = build_query_weights_for_trial(df_train_final_tr, dummy, max_age_cap_final)
        w_train_row = row_weights_from_query_weights(df_train_final_tr, w_q_like, query_col="query_id")

    # --- Train final model
    if use_decay:
        train_pool = Pool(
            data=X_train_final,
            label=y_train_final.values,
            group_id=group_id_train_final,
            group_weight=w_train_row,  # <-- key change
            cat_features=cat_feature_indices,
        )
    else:
        train_pool = Pool(
           data=X_train_final,
           label=y_train_final.values,
           group_id=group_id_train_final,
           cat_features=cat_feature_indices,
       )

    model_kwargs = dict(
        loss_function="YetiRank",
        eval_metric=cat_eval_metric,
        boosting_type="Ordered",
        sampling_unit="Group",
        bootstrap_type="Bernoulli",
        random_seed=seed,
        task_type="CPU",
        thread_count=thread_count,   # <--- add this
        iterations=int(num_trees),
        verbose=False,
    )


    # apply tree params
    # (learning_rate omitted for default modes if not present)
    if best_tree is not None:
        for k, v in best_tree.items():
            if k in ["depth", "learning_rate", "l2_leaf_reg", "subsample"]:
                model_kwargs[k] = v

    model = CatBoostRanker(**model_kwargs)

    t_train_start = time.perf_counter()
    model.fit(train_pool, verbose=False)
    t_train_end = time.perf_counter()
    train_time_seconds = float(t_train_end - t_train_start)
    print(f"\n[{variant_sheet}] Final training time: {train_time_seconds:.3f} seconds")
    
    # OUT_ROOT = Path(f"artifacts_predict{final_test_year}")
    
    # save_catboost_variant(
    #     variant_name=variant_sheet,
    #     model=model,
    #     out_root=OUT_ROOT,
    #     final_test_year=final_test_year,
    #     train_years_final=train_years_final,
    #     feature_cols=present_features_final,
    #     cat_feature_indices=cat_feature_indices,
    #     transform_specs=(transform_specs_final if use_skew else None),
    #     extra_meta={
    #         "num_trees_final": int(num_trees),
    #         "train_time_seconds": train_time_seconds,
    #         "cv_best_mean_ndcg@10": float(cv_best) if cv_best is not None else None,
    #         "use_decay": bool(use_decay),
    #         "use_skew": bool(use_skew),
    #         "tuned_tree": bool(tuned_tree),
    #     },
    # )
    

    # --- Predict + eval
    df_test_pred, pred_time_seconds, n_races, n_riders = time_prediction_cat(
        model=model,
        X_test=X_test_final,
        df_test_template=df_test_final_tr,
        pred_col="pred",
        model_name=variant_sheet,
        # cat_feature_indices=cat_feature_indices,  # if you upgraded time_prediction_cat to use Pool
    )
    
    df_summary, metrics = evaluate_on_2024(df_test_pred, "pred", final_test_year)
    
    # --- Optional SHAP per race (adds columns to df_summary)
    df_summary = add_shap_per_race_catboost(
        model=model,
        X_test=X_test_final,
        df_test_with_pred=df_test_pred,
        df_race_summary=df_summary,
        feature_names=present_features_final,
        cat_feature_indices=cat_feature_indices,
        k_top=10,
    )

    # --- Hyperparams + timings table (like your LightGBM style)
    rows = []

    # tree params
    if tuned_tree:
        for k in cat_tree_param_keys:
            if best_tree is not None and k in best_tree:
                rows.append({"type": "tree", "param": k, "value": best_tree[k]})
    else:
        # defaults we used
        rows.append({"type": "tree", "param": "learning_rate", "value": "auto (not set)"})
        rows.append({"type": "tree", "param": "depth",         "value": best_tree.get("depth", 6)})
        rows.append({"type": "tree", "param": "l2_leaf_reg",   "value": best_tree.get("l2_leaf_reg", 3.0)})
        rows.append({"type": "tree", "param": "subsample",     "value": best_tree.get("subsample", 0.5)})

    # decay params
    if use_decay:
        for k in decay_param_keys:
            if k in best_decay:
                rows.append({"type": "decay", "param": k, "value": best_decay[k]})

    # meta + metrics
    rows.append({"type": "meta", "param": "use_skew",              "value": bool(use_skew)})
    rows.append({"type": "meta", "param": "use_decay",             "value": bool(use_decay)})
    rows.append({"type": "meta", "param": "tuned_tree",            "value": bool(tuned_tree)})
    rows.append({"type": "meta", "param": "num_trees",             "value": int(num_trees)})
    rows.append({"type": "meta", "param": "cv_best_mean_ndcg@10",  "value": float(cv_best) if cv_best is not None else np.nan})
    rows.append({"type": "meta", "param": "train_time_seconds",    "value": float(train_time_seconds)})
    rows.append({"type": "meta", "param": "pred_time_seconds",     "value": float(pred_time_seconds)})
    rows.append({"type": "meta", "param": "pred_time_per_race",    "value": float(pred_time_seconds / n_races)})
    rows.append({"type": "meta", "param": "pred_time_per_rider",   "value": float(pred_time_seconds / n_riders)})

    if study is not None:
        for f in folds:
            fname = f["name"]
            rows.append({"type": "cv", "param": f"ndcg_{fname}",  "value": float(study.best_trial.user_attrs.get(f"ndcg_{fname}", np.nan))})
            rows.append({"type": "cv", "param": f"trees_{fname}", "value": float(study.best_trial.user_attrs.get(f"trees_{fname}", np.nan))})

    for mk, mv in metrics.items():
        rows.append({"type": "metric", "param": mk, "value": mv})

    df_hparams = pd.DataFrame(rows)

    return df_summary, df_hparams


